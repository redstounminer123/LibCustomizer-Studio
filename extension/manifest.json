{
  "manifest_version": 3,
  "name": "LibCustomizer Pro v5.9 — Полная кастомизация шапки, форума и подвала .x6_e4",
  "short_name": "LibCustomizer",
  "version": "5.9.0",
  "description": "Персонализация MangaLib, RanobeLib, AnimeLib: единая подложка подвала (.x6_e4), настраиваемый форум, прозрачные рамки, адаптивная шапка и AdBlock.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://mangalib.me/*",
    "*://*.mangalib.me/*",
    "*://mangalib.org/*",
    "*://*.mangalib.org/*",
    "*://*.shlib.life/*",
    "*://shlib.life/*",
    "*://*.animelib.org/*",
    "*://animelib.org/*",
    "*://ranobelib.me/*",
    "*://*.ranobelib.me/*",
    "*://ranobelib.org/*",
    "*://*.ranobelib.org/*",
    "*://hentailib.me/*",
    "*://*.hentailib.me/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LibCustomizer Pro v5.9 — Настройки и Блоки главной"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mangalib.me/*",
        "*://*.mangalib.me/*",
        "*://mangalib.org/*",
        "*://*.mangalib.org/*",
        "*://*.shlib.life/*",
        "*://shlib.life/*",
        "*://*.animelib.org/*",
        "*://animelib.org/*",
        "*://ranobelib.me/*",
        "*://*.ranobelib.me/*",
        "*://ranobelib.org/*",
        "*://*.ranobelib.org/*",
        "*://hentailib.me/*",
        "*://*.hentailib.me/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "libcustomizer@libfamily.addons",
      "strict_min_version": "109.0"
    }
  }
}